{
  "name": "valetudo-frontend",
  "homepage": ".",
  "scripts": {
    "analyze": "npm run build_stats && npm run analyze_stats",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build_stats": "vite build --mode stats",
    "analyze_stats": "vite preview --open /bundle-stats.html",
    "watch": "vite build --watch",
    "ts-check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint -c .automated.eslintrc.json .",
    "lint_fix": "eslint -c .automated.eslintrc.json . --fix",
    "lint_pedantic": "eslint -c .pedantic.eslintrc.json .",
    "prepare_commit": "npm run lint_fix && npm run ts-check"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "@tanstack/react-query": "5.90.19",
    "@tanstack/react-query-devtools": "5.91.2",
    "axios": "1.13.2",
    "eliza-as-promised": "git+https://npm@github.com/Hypfer/eliza-as-promised#0.0.3",
    "jsmpeg": "git+https://npm@github.com/Hypfer/jsmpeg.git#2026.08.0",
    "notistack": "3.0.2",
    "react": "19.2.3",
    "react-div-100vh": "0.7.0",
    "react-dom": "19.2.3",
    "react-joystick-component": "6.2.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.12.0",
    "reconnecting-eventsource": "1.6.4",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "semaphore": "1.1.0",
    "use-long-press": "3.3.0",
    "zustand": "5.0.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "rollup-plugin-visualizer": "7.1.1",
    "vite": "8.3.0",
    "vite-plugin-svgr": "5.2.0"
  }
}
